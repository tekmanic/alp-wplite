server {
    listen 80;
    index index.html index.php;

    ## Begin - Server Info
    root /usr/src/wordpress;
    server_name $hostname;
    ## End - Server Info

    ## Begin - Hardening
    # Block well-known scanners / malicious bots (map defined in nginx.conf)
    if ($block_ua) { return 403; }

    # General per-IP rate limit (login + REST API have their own tighter zones)
    limit_req zone=wpgeneral burst=50 nodelay;

    # WordPress XML-RPC is a common brute-force / pingback-DoS vector. Disable it.
    location = /xmlrpc.php { return 403; }

    # Deny direct access to sensitive / config files
    location ~* /(wp-config\.php|wp-config\.php~|\.env|\.env\..*|\.git/.*|\.gitignore|\.gitattributes|composer\.(json|lock)|package\.(json|lock)|license\.txt|readme\.html|nginx\.conf|web\.config|htaccess\.txt|\.htaccess|\.DS_Store) { return 403; }
    # Deny all direct access for these folders
    location ~* /(\.git|cache|bin|logs|backup|tests|node_modules)/.*$ { return 403; }
    # Deny running scripts inside core system folders
    location ~* /(system|vendor)/.*\.(txt|xml|md|html|yaml|yml|php|pl|py|cgi|twig|sh|bat)$ { return 403; }
    # Deny running scripts inside user folder
    location ~* /user/.*\.(txt|md|yaml|yml|php|pl|py|cgi|twig|sh|bat)$ { return 403; }
    ## End - Hardening

    ## Begin - Index
    # for subfolders, simply adjust:
    # `location /subfolder {`
    # and the rewrite to use `/subfolder/index.php`
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # REST API: tighter rate limit to blunt enumeration / abuse
    location ~ ^/wp-json/ {
        limit_req zone=wpapi burst=20 nodelay;
        rewrite ^/wp-json/(.*)$ /index.php?$1 last;
    }

    # Login: tight rate limit to blunt credential brute-forcing (returns 429, not a ban)
    location = /wp-login.php {
        limit_req zone=wplogin burst=10 nodelay;
        try_files $uri /index.php?$query_string;
    }
    ## End - Index

    ## Begin - PHP
    location ~ \.php$ {
        # Choose either a socket or TCP/IP address
        # fastcgi_pass unix:/usr/local/var/run/php-fpm.sock;
        # fastcgi_pass unix:/var/run/php5-fpm.sock; #legacy
        fastcgi_pass 127.0.0.1:9000;

        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/$fastcgi_script_name;
        # (removed a stale Grav leftover: upload_tmp_dir=/var/www/grav/tmp — that path
        #  does not exist; PHP uses its default upload tmp dir instead)
    }
    ## End - PHP

    ##Enable Caching for tools that analyze speed performance (like gtmetrix)
    ### Media: images, icons, video, audio, HTC
    location ~* \.(?:jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc)$ {
      expires 1M;
      access_log off;
      add_header Cache-Control "public";
    }

    ### CSS and Javascript
    location ~* \.(?:css|js)$ {
      expires 1y;
      access_log off;
      add_header Cache-Control "public";
    }

}
